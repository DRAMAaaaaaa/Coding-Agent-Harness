# Safe-to-commit variable names only. Never place real credentials in this file.

# Non-secret provider selection. Values will be fixed after SPEC approval.
HARNESS_LLM_PROVIDER=
HARNESS_LLM_MODEL=

# Development-only fallback. Prefer the OS keyring or the encrypted credential
# store selected in SPEC. A copied .env file is plaintext and process-visible.
HARNESS_LLM_API_KEY=
