# Safe-to-commit variable names only. Never place real credentials in this file.

# Non-secret provider selection. The MVP product wires only the deterministic mock.
HARNESS_LLM_PROVIDER=mock
HARNESS_LLM_MODEL=scripted-mock

# Reserved placeholder only: the MVP runtime does not consume provider credentials.
# A copied .env file is plaintext and process-visible; never put a real value here.
HARNESS_LLM_API_KEY=<replace-locally-never-commit>

# Safe bounded runtime defaults.
HARNESS_BIND_HOST=127.0.0.1
HARNESS_COMMAND_TIMEOUT_SECONDS=300
HARNESS_MAX_TASK_CYCLES=8
HARNESS_MAX_SAME_FINGERPRINT=3
HARNESS_NO_PROGRESS_LIMIT=2
HARNESS_MAX_CONCURRENT_TASKS=3
